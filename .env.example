# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=crazy_cookies
DB_USER=crazy_cookies_user
DB_PASSWORD=secure_password
DB_ROOT_PASSWORD=rootpassword

# Database URL for Prisma
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@crazycookies.com
SMTP_PASS=your-email-password-or-app-password
EMAIL_FROM="Crazy Cookies <noreply@crazycookies.com>"

# WhatsApp Configuration
WHATSAPP_PHONE=573123456789

# Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
UPLOAD_PATH=./uploads

# Backend Configuration
BACKEND_PORT=3000
BACKEND_URL=http://localhost:3000
NODE_ENV=development

# Frontend Configuration
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# CORS Configuration
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# Rate Limiting
RATE_LIMIT_TTL=900
RATE_LIMIT_MAX=100
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REVIEW_MAX=3

# Cart Configuration
CART_EXPIRATION_HOURS=24

# Cloudinary Configuration (opcional, para futuro)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Redis Configuration (opcional, para futuro)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
